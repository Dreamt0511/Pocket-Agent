# Pocket-Agent 环境变量配置示例
# 复制此文件为.env并修改对应值即可生效

# MCP服务器地址
MCP_SERVER_URL=http://127.0.0.1:7474/mcp

# 默认LLM服务地址
DEFAULT_LLM_BASE_URL=https://api.longcat.chat/openai/v1

# Ollama本地服务地址
OLLAMA_BASE_URL=http://localhost:11434

# LLM API密钥（可选）
# LLM_API_KEY=your_api_key_here

# LLM模型名称（可选）
# LLM_MODEL=longcat-flash-lite
