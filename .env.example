# Pocket-Agent 环境变量配置示例
# 复制此文件为.env并修改对应值即可生效

# MCP服务器地址
MCP_SERVER_URL=http://127.0.0.1:7474/mcp

# ==================== LLM 配置 ====================
# 兼容 OpenAI 格式的 LLM API（云端或本地）
DEFAULT_LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-xxx
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=8000

# Ollama本地服务地址（不需要可以删除）
# OLLAMA_BASE_URL=http://localhost:11434

# ==================== 子Agent（Executor）模型配置 ====================
# 默认与主Agent共用相同模型，如需让子Agent使用不同模型，取消注释并设置以下变量：
# EXECUTOR_LLM_BASE_URL=http://127.0.0.1:11434/v1
# EXECUTOR_API_KEY=ollama
# EXECUTOR_MODEL=qwen2.5:7b
# EXECUTOR_TEMPERATURE=0.3
# EXECUTOR_MAX_TOKENS=8192

# ==================== Embedding 配置 ====================
# 场景一：使用本地 llama-server（推荐，需编译 llama.cpp）
# 下载模型: https://hf-mirror.com/gpustack/bge-m3-GGUF/blob/main/bge-m3-Q4_K_M.gguf
# App 启动时会根据 EMBEDDING_MODEL_PATH 自动拉起 llama-server
EMBEDDING_SERVER_URL=http://127.0.0.1:8080/v1
EMBEDDING_MODEL=bge-m3
EMBEDDING_MODEL_PATH=                  # GGUF 模型文件绝对路径，如 /sdcard/Pocket-Agent/bge-m3-Q4_K_M.gguf

# 场景二：使用远程 Embedding API（如 OpenAI、Jina 等）
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=sk-xxx
# EMBEDDING_MODEL=text-embedding-3-small
