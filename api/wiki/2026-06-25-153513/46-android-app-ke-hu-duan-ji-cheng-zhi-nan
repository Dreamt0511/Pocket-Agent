### 获取技能列表

```kotlin
data class SkillItem(
    val name: String,
    val description: String,
    val path: String,
    val content: String
)

data class SkillsResponse(
    val main_skills: List<SkillItem>,
    val executor_skills: List<SkillItem>,
    val auto_skills: List<SkillItem>
)

// GET /skills
fun fetchSkills(baseUrl: String, callback: (SkillsResponse?) -> Unit) {
    val request = Request.Builder()
        .url("$baseUrl/skills")
        .get()
        .build()
    
    client.newCall(request).enqueue(object : Callback {
        override fun onResponse(call: Call, response: Response) {
            val skills = JsonParser.parseString(response.body?.string())
                .asJsonObject
                .let { Gson().fromJson(it, SkillsResponse::class.java) }
            callback(skills)
        }
        override fun onFailure(call: Call, e: IOException) {
            callback(null)
        }
    })
}
```

