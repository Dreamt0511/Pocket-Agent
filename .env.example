# Pocket-Agent 环境变量配置示例
# 复制此文件为.env并修改对应值即可生效
# 注意：手机环境不需要修改，默认使用本地llama-server配置

# MCP服务器地址
MCP_SERVER_URL=http://127.0.0.1:7474/mcp

# ==================== 电脑端配置（云端API） ====================
# 电脑端使用云端LLM服务时配置
# DEFAULT_LLM_BASE_URL=https://api.longcat.chat/openai/v1
# LLM_API_KEY=your_api_key_here
# LLM_MODEL=longcat-flash-lite

# ==================== 手机端配置（本地llama-server） ====================
# 手机端使用本地llama-server，默认配置如下，通常不需要修改
DEFAULT_LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_API_KEY=dummy
LLM_MODEL=gelab-zero-4b-preview
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=8000

# Ollama本地服务地址（不需要可以删除）
# OLLAMA_BASE_URL=http://localhost:11434

# ==================== 子Agent（Executor）模型配置 ====================
# 默认与主Agent共用相同模型，如需让子Agent使用不同模型，取消注释并设置以下变量：
# EXECUTOR_LLM_BASE_URL=http://127.0.0.1:11434/v1
# EXECUTOR_API_KEY=ollama
# EXECUTOR_MODEL=qwen2.5:7b
# EXECUTOR_TEMPERATURE=0.3
# EXECUTOR_MAX_TOKENS=8192

# ==================== Embedding 配置（可选） ====================
# 本地 llama-server embedding 服务（推荐，需编译 llama.cpp）
# 下载模型: https://hf-mirror.com/gpustack/bge-m3-GGUF/blob/main/bge-m3-Q4_K_M.gguf
# 放到项目根目录下即可，App 启动时自动拉起服务
EMBEDDING_SERVER_URL=http://127.0.0.1:8080/v1
EMBEDDING_MODEL=bge-m3
EMBEDDING_MODEL_PATH=                  # GGUF 模型文件绝对路径，如 /sdcard/Pocket-Agent/bge-m3-Q4_K_M.gguf
# EMBEDDING_BASE_URL=                  # 使用远程 API 时填写
# EMBEDDING_API_KEY=sk-xxx
