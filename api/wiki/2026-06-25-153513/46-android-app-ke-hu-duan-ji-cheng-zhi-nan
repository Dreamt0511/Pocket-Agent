### 连接验证

Android App 启动后应立即验证服务可达性：

```kotlin
// Kotlin 使用 OkHttp
val client = OkHttpClient.Builder()
    .connectTimeout(5, TimeUnit.SECONDS)
    .readTimeout(10, TimeUnit.SECONDS)
    .build()

fun checkHealth(baseUrl: String, callback: (Boolean, String) -> Unit) {
    val request = Request.Builder()
        .url("$baseUrl/health")
        .get()
        .build()
    
    client.newCall(request).enqueue(object : Callback {
        override fun onResponse(call: Call, response: Response) {
            val body = response.body?.string() ?: "{}"
            val ok = response.isSuccessful && body.contains("\"status\":\"ok\"")
            callback(ok, body)
        }
        override fun onFailure(call: Call, e: IOException) {
            callback(false, e.message ?: "连接失败")
        }
    })
}
```

服务正常时返回：
```json
{"status": "ok", "python": "3.11.5", "project_root": "/sdcard/Pocket-Agent"}
```

