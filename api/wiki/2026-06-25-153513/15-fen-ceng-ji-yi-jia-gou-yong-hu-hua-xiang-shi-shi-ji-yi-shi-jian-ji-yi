    subgraph "三层记忆架构"
        Profile["🧑 用户画像<br/>memory/user_profile.md"]
        FactMem["📌 事实记忆<br/>memory_type='fact'"]
        EpiMem["📝 事件记忆<br/>memory_type='episodic'"]
