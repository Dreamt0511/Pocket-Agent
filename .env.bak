# Pocket-Agent 环境变量配置
# 🌐 电脑端使用云端API时配置下面参数，📱 手机端使用本地llama-server不需要修改
# 两种环境二选一，注释掉不用的配置即可

# MCP服务器地址
MCP_SERVER_URL=http://127.0.0.1:7474/mcp

# ==================== 📱 手机端默认配置（本地llama-server） ====================
# 手机端直接使用下面配置，启动llama-server后即可运行
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=8000

# DEFAULT_LLM_BASE_URL=http://127.0.0.1:8080/v1
# LLM_API_KEY=dummy
# LLM_MODEL=gelab-zero-4b-preview

# ==================== 🌐 电脑端配置（云端API） ====================
# 电脑端使用云端服务时注释上面手机端配置，取消下面注释
DEFAULT_LLM_BASE_URL=https://api.longcat.chat/openai/v1
LLM_API_KEY=ak_2NP8EQ3Pv27R5ri1La5DB4NH7A61D
LLM_MODEL=LongCat-Flash-Lite

# Ollama本地服务地址（不需要可以删除）
# OLLAMA_BASE_URL=http://localhost:11434
