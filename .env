# Pocket-Agent 环境变量配置
# 根据实际部署情况修改即可

# MCP服务器地址
MCP_SERVER_URL=http://127.0.0.1:7474/mcp

# 默认LLM服务地址
DEFAULT_LLM_BASE_URL=https://api.longcat.chat/openai/v1

# Ollama本地服务地址
OLLAMA_BASE_URL=http://localhost:11434

# LLM API密钥（如有需要请取消注释并填写）
# LLM_API_KEY=

# LLM模型名称（如有需要请取消注释并填写）
# LLM_MODEL=longcat-flash-lite
